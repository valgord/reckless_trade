APP_ENV=home
TRADING_MODE=demo
RUN_NAUTILUS_NODE=false
ENABLE_DEMO_STRATEGY=false
ENABLE_CARRY_OBSERVER=false
LOG_LEVEL=INFO
NAUTILUS_LOG_LEVEL=WARNING

# Replace this password in both values before the first start.
POSTGRES_DB=trading
POSTGRES_USER=trading
POSTGRES_PASSWORD=replace-with-long-random-password
DATABASE_URL=postgresql+asyncpg://trading:replace-with-long-random-password@postgres:5432/trading

# Demo credentials only. Never grant withdrawal permission.
BYBIT_DEMO_API_KEY=
BYBIT_DEMO_API_SECRET=
BYBIT_DEMO_ORDER_SMOKE_MAX_NOTIONAL=10

BYBIT_API_KEY=
BYBIT_API_SECRET=
ALLOW_LIVE_TRADING=false

# managed: project Compose owns the ROCm Ollama container and ollama_data volume.
# external: an existing Ollama container publishes port 11434 on the home server.
OLLAMA_DEPLOYMENT=managed
HOME_DOCKER_SUBNET=172.30.0.0/24
OLLAMA_IMAGE=ollama/ollama:rocm
OLLAMA_VOLUME_NAME=reckless_trade_ollama_data
OLLAMA_BASE_URL=http://ollama:11434
# Used only when OLLAMA_DEPLOYMENT=external.
OLLAMA_EXTERNAL_URL=http://host.docker.internal:11434
OLLAMA_HOST_CHECK_URL=http://localhost:11434
# Optional: attach model clients to an existing Ollama container network instead of using the host-published port.
OLLAMA_EXTERNAL_DOCKER_NETWORK=
OLLAMA_MODEL=qwen3:14b
INTELLIGENCE_ENABLED=true
CARRY_ALERT_LLM_ENABLED=true
CARRY_ALERT_STALE_SECONDS=180
CARRY_ALERT_PROFIT_REVIEW_USDT=0.05
CARRY_ALERT_MAXIMUM_LOSS_USDT=-2
CARRY_ALERT_MIN_FUNDING_SETTLEMENTS=3
# Optional HTTPS endpoint; receives sanitized alert JSON only when alert state changes.
CARRY_ALERT_WEBHOOK_URL=
TELEGRAM_ALERTS_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Public market-data scanner. Empty symbols means auto-discover the most liquid common Spot/Linear pairs.
CARRY_SCANNER_REST_URL=https://api.bybit.com
CARRY_SCANNER_SYMBOLS=
CARRY_SCANNER_MAX_SYMBOLS=20
CARRY_SCANNER_FUNDING_HISTORY_LIMIT=21
CARRY_SCANNER_TARGET_NOTIONAL_USDT=100
CARRY_SCANNER_HORIZON_SETTLEMENTS=3
CARRY_SCANNER_MIN_TURNOVER_24H_USDT=10000000
CARRY_SCANNER_MIN_FUNDING_SAMPLES=6
CARRY_SCANNER_MIN_POSITIVE_SHARE=0.6
CARRY_SCANNER_HISTORY_DB=/app/data/carry/scanner-history.sqlite3
CARRY_SCANNER_HISTORY_RETENTION_DAYS=90
CARRY_SCANNER_ALERT_STATE_PATH=/app/data/runtime/carry-scanner-alert-state.json
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=market_events

# Keep ingestion and LLM forwarding off through the initial home validation.
NEWS_ENABLED=false
NEWS_RSS_URLS=
NEWS_POLL_SECONDS=900
NEWS_SOURCE_MIN_POLL_SECONDS=900
NEWS_STORE_DATABASE=true
NEWS_FORWARD_TO_INTELLIGENCE=false
NEWS_ARCHIVE_PATH=/app/data/news
NEWS_STATE_PATH=/app/data/runtime/news-worker-state.json
INTELLIGENCE_URL=http://intelligence:8010/analyse
