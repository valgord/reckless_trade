APP_ENV=dev
TRADING_MODE=demo
RUN_NAUTILUS_NODE=false
LOG_LEVEL=INFO
POSTGRES_DB=trading
POSTGRES_USER=trading
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+asyncpg://trading:change-me@postgres:5432/trading

# Bybit demo. Create API keys on the Demo account; do not grant withdrawals.
BYBIT_DEMO_API_KEY=
BYBIT_DEMO_API_SECRET=

# Live credentials are intentionally separate and live is locked twice.
BYBIT_API_KEY=
BYBIT_API_SECRET=
ALLOW_LIVE_TRADING=false

# Intelligence
INTELLIGENCE_ENABLED=false
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen3:14b
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=market_events

# News ingestion (comma-separated RSS URLs configured by the operator)
NEWS_ENABLED=false
NEWS_RSS_URLS=
NEWS_POLL_SECONDS=60
INTELLIGENCE_URL=http://intelligence:8010/analyse
