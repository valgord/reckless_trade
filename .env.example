APP_ENV=dev
TRADING_MODE=demo
RUN_NAUTILUS_NODE=false
ENABLE_DEMO_STRATEGY=false
ENABLE_CARRY_OBSERVER=false
LOG_LEVEL=INFO
NAUTILUS_LOG_LEVEL=WARNING
POSTGRES_DB=trading
POSTGRES_USER=trading
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+asyncpg://trading:change-me@postgres:5432/trading

# Bybit demo. Create API keys on the Demo account; do not grant withdrawals.
BYBIT_DEMO_API_KEY=
BYBIT_DEMO_API_SECRET=
# Order smoke additionally requires the exact confirmation accepted by the Make target.
BYBIT_DEMO_ORDER_SMOKE_MAX_NOTIONAL=10

# Live credentials are intentionally separate and live is locked twice.
BYBIT_API_KEY=
BYBIT_API_SECRET=
ALLOW_LIVE_TRADING=false

# Intelligence
INTELLIGENCE_ENABLED=false
OLLAMA_BASE_URL=http://ollama:11434
# CPU-safe validation defaults. Override both values for an accelerator deployment.
OLLAMA_IMAGE=ollama/ollama:0.11.4
OLLAMA_MODEL=qwen3:0.6b
CARRY_ALERT_LLM_ENABLED=false
CARRY_ALERT_STALE_SECONDS=180
CARRY_ALERT_PROFIT_REVIEW_USDT=0.05
CARRY_ALERT_MAXIMUM_LOSS_USDT=-2
CARRY_ALERT_MIN_FUNDING_SETTLEMENTS=3
CARRY_ALERT_WEBHOOK_URL=
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=market_events

# News ingestion (comma-separated RSS URLs configured by the operator)
NEWS_ENABLED=false
NEWS_RSS_URLS=
NEWS_POLL_SECONDS=60
NEWS_SOURCE_MIN_POLL_SECONDS=60
NEWS_STORE_DATABASE=true
NEWS_FORWARD_TO_INTELLIGENCE=false
NEWS_ARCHIVE_PATH=/app/data/news
NEWS_STATE_PATH=/app/data/runtime/news-worker-state.json
INTELLIGENCE_URL=http://intelligence:8010/analyse
